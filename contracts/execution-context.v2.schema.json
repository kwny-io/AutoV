{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drama.example.invalid/contracts/execution-context.v2.schema.json",
  "title": "execution-context v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "series_id": {
      "type": "string",
      "minLength": 1
    },
    "branch_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "home_region": {
      "type": "string",
      "minLength": 1
    },
    "home_cell": {
      "type": "string",
      "minLength": 1
    },
    "manifest_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "node_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "execution_fence": {
      "type": "integer",
      "minimum": 1
    },
    "memory_checkpoint": {
      "type": "object",
      "properties": {
        "branch_id": {
          "type": "string",
          "minLength": 1
        },
        "commit_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "branch_id",
        "commit_sequence",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "policy_ref": {
      "type": "object",
      "properties": {
        "service_id": {
          "type": "string",
          "pattern": "^S[0-9]{2}$"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "service_id",
        "id",
        "revision",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1
        },
        "principal_type": {
          "type": "string",
          "enum": [
            "human",
            "service",
            "api_client",
            "mcp_client"
          ]
        },
        "delegation_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "principal_id",
        "principal_type",
        "delegation_id"
      ],
      "additionalProperties": false
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "project_id",
    "series_id",
    "branch_id",
    "episode_id",
    "home_region",
    "home_cell",
    "manifest_ref",
    "node_id",
    "node_epoch",
    "execution_fence",
    "memory_checkpoint",
    "policy_ref",
    "actor",
    "command_id",
    "request_hash",
    "trace_id"
  ],
  "additionalProperties": false
}
