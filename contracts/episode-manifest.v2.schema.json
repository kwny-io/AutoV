{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drama.example.invalid/contracts/episode-manifest.v2.schema.json",
  "title": "episode-manifest v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "series_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "branch_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_fence": {
      "type": "integer",
      "minimum": 1
    },
    "home_cell": {
      "type": "string",
      "minLength": 1
    },
    "source_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "string",
            "pattern": "^S[0-9]{2}$"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "service_id",
          "id",
          "revision",
          "content_hash"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "binding_set_ref": {
      "type": "object",
      "properties": {
        "service_id": {
          "type": "string",
          "pattern": "^S[0-9]{2}$"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "service_id",
        "id",
        "revision",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "memory_checkpoint": {
      "type": "object",
      "properties": {
        "commit_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "commit_sequence",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "policy_ref": {
      "type": "object",
      "properties": {
        "service_id": {
          "type": "string",
          "pattern": "^S[0-9]{2}$"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "service_id",
        "id",
        "revision",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "node_states": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "node_epoch": {
            "type": "integer",
            "minimum": 1
          },
          "input_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "locked": {
            "type": "boolean"
          },
          "accepted_artifact_ref": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "service_id": {
                    "type": "string",
                    "pattern": "^S[0-9]{2}$"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "content_hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "service_id",
                  "id",
                  "revision",
                  "content_hash"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "node_id",
          "node_epoch",
          "input_fingerprint",
          "locked",
          "accepted_artifact_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "parent_manifest_ref": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "revision",
            "content_hash"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "manifest_id",
    "revision",
    "tenant_id",
    "project_id",
    "series_id",
    "episode_id",
    "branch_id",
    "execution_fence",
    "home_cell",
    "source_revisions",
    "binding_set_ref",
    "memory_checkpoint",
    "policy_ref",
    "node_states",
    "parent_manifest_ref",
    "content_hash"
  ],
  "additionalProperties": false
}
