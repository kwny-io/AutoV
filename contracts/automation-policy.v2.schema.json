{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drama.example.invalid/contracts/automation-policy.v2.schema.json",
  "title": "automation-policy v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "guided",
        "stage_review",
        "exception_assisted",
        "unattended_batch"
      ]
    },
    "generation_mode": {
      "type": "string",
      "enum": [
        "manual",
        "auto"
      ]
    },
    "acceptance_mode": {
      "type": "string",
      "enum": [
        "manual",
        "auto_if_qc_pass"
      ]
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope_type": {
            "type": "string",
            "enum": [
              "project",
              "episode",
              "stage",
              "node"
            ]
          },
          "scope_id": {
            "type": "string",
            "minLength": 1
          },
          "generation_mode": {
            "type": "string",
            "enum": [
              "manual",
              "auto"
            ]
          },
          "acceptance_mode": {
            "type": "string",
            "enum": [
              "manual",
              "auto_if_qc_pass"
            ]
          },
          "reviewer_roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "locked": {
            "type": "boolean"
          }
        },
        "required": [
          "scope_type",
          "scope_id",
          "generation_mode",
          "acceptance_mode",
          "reviewer_roles",
          "locked"
        ],
        "additionalProperties": false
      }
    },
    "repair_limits": {
      "type": "object",
      "properties": {
        "max_business_attempts_per_shot": {
          "type": "integer",
          "minimum": 1
        },
        "max_identical_strategy_repeats": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_business_attempts_per_shot",
        "max_identical_strategy_repeats"
      ],
      "additionalProperties": false
    },
    "exception_behavior": {
      "type": "string",
      "enum": [
        "wait_review",
        "isolate_branch"
      ]
    },
    "required_gates": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "script",
          "canonical_asset",
          "storyboard",
          "rough_cut",
          "final_master",
          "budget_increase",
          "external_publish"
        ]
      }
    },
    "hard_rules": {
      "type": "object",
      "properties": {
        "budget_scope_id": {
          "type": "string",
          "minLength": 1
        },
        "rights_required": {
          "const": true
        },
        "enforce_data_residency": {
          "const": true
        },
        "no_incomplete_formal_delivery": {
          "const": true
        },
        "allow_silent_identity_downgrade": {
          "const": false
        }
      },
      "required": [
        "budget_scope_id",
        "rights_required",
        "enforce_data_residency",
        "no_incomplete_formal_delivery",
        "allow_silent_identity_downgrade"
      ],
      "additionalProperties": false
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "revision",
    "tenant_id",
    "mode",
    "generation_mode",
    "acceptance_mode",
    "overrides",
    "repair_limits",
    "exception_behavior",
    "required_gates",
    "hard_rules",
    "effective_at",
    "created_by"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "unattended_batch"
          }
        }
      },
      "then": {
        "properties": {
          "exception_behavior": {
            "const": "isolate_branch"
          }
        }
      }
    }
  ]
}
