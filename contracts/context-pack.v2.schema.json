{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drama.example.invalid/contracts/context-pack.v2.schema.json",
  "title": "context-pack v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "context_pack_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "series_id": {
      "type": "string",
      "minLength": 1
    },
    "branch_id": {
      "type": "string",
      "minLength": 1
    },
    "task_role": {
      "type": "string",
      "minLength": 1
    },
    "target_episode_order": {
      "type": "integer",
      "minimum": 1
    },
    "perspective": {
      "type": "string",
      "enum": [
        "omniscient",
        "character",
        "audience"
      ]
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "commit_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "commit_sequence",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "claim_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "string",
            "pattern": "^S[0-9]{2}$"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "service_id",
          "id",
          "revision",
          "content_hash"
        ],
        "additionalProperties": false
      }
    },
    "asset_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "string",
            "pattern": "^S[0-9]{2}$"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "service_id",
          "id",
          "revision",
          "content_hash"
        ],
        "additionalProperties": false
      }
    },
    "unresolved_conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prohibited_assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "token_budget": {
      "type": "integer",
      "minimum": 1
    },
    "tokens_used": {
      "type": "integer",
      "minimum": 0
    },
    "source_watermark": {
      "type": "integer",
      "minimum": 0
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "context_pack_id",
    "revision",
    "tenant_id",
    "series_id",
    "branch_id",
    "task_role",
    "target_episode_order",
    "perspective",
    "checkpoint",
    "claim_refs",
    "asset_refs",
    "unresolved_conflicts",
    "prohibited_assumptions",
    "token_budget",
    "tokens_used",
    "source_watermark",
    "content_hash"
  ],
  "additionalProperties": false
}
