{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drama.example.invalid/contracts/memory-claim.v2.schema.json",
  "title": "memory-claim v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "series_id": {
      "type": "string",
      "minLength": 1
    },
    "branch_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "world_rule",
        "character_profile",
        "story_event",
        "entity_state",
        "relationship",
        "knowledge_state",
        "plot_thread",
        "creative_preference"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "accepted",
        "superseded",
        "rejected"
      ]
    },
    "fact": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "subject_id",
        "predicate",
        "value"
      ],
      "additionalProperties": false
    },
    "story_validity": {
      "type": "object",
      "properties": {
        "clock_id": {
          "type": "string",
          "minLength": 1
        },
        "valid_from_tick": {
          "type": "integer",
          "minimum": 0
        },
        "valid_to_tick": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "clock_id",
        "valid_from_tick",
        "valid_to_tick"
      ],
      "additionalProperties": false
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "commit_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "string",
            "pattern": "^S[0-9]{2}$"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "service_id",
          "id",
          "revision",
          "content_hash"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "accepted_manifest_ref": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "revision",
            "content_hash"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "epistemic_scope": {
      "type": "object",
      "properties": {
        "perspective": {
          "type": "string",
          "enum": [
            "omniscient",
            "character",
            "audience"
          ]
        },
        "knower_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "belief_type": {
          "type": "string",
          "enum": [
            "fact",
            "knows",
            "believes",
            "unaware",
            "uncertain"
          ]
        },
        "audience_reveal_episode_order": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "perspective",
        "knower_ids",
        "belief_type",
        "audience_reveal_episode_order"
      ],
      "additionalProperties": false
    },
    "supersedes_claim_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "string",
            "pattern": "^S[0-9]{2}$"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "service_id",
          "id",
          "revision",
          "content_hash"
        ],
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "schema_version",
    "claim_id",
    "revision",
    "tenant_id",
    "series_id",
    "branch_id",
    "kind",
    "status",
    "fact",
    "story_validity",
    "recorded_at",
    "commit_sequence",
    "source_refs",
    "accepted_manifest_ref",
    "epistemic_scope",
    "supersedes_claim_refs",
    "confidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "accepted_manifest_ref": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "content_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "revision",
              "content_hash"
            ],
            "additionalProperties": false
          },
          "commit_sequence": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  ]
}
