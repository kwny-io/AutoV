{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drama.example.invalid/contracts/event-envelope.v1.schema.json",
  "title": "EventEnvelope v1",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "aggregate_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "aggregate_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "tenant_id",
    "project_id",
    "run_id",
    "aggregate_id",
    "aggregate_sequence",
    "occurred_at",
    "correlation_id",
    "payload"
  ],
  "additionalProperties": false
}
