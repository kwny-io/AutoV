{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drama.example.invalid/contracts/shot-spec.v1.schema.json",
  "title": "ShotSpec v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "shot_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "display_locator": {
      "type": "object",
      "properties": {
        "episode": {
          "type": "integer",
          "minimum": 1
        },
        "scene": {
          "type": "integer",
          "minimum": 1
        },
        "shot": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "episode",
        "scene",
        "shot"
      ],
      "additionalProperties": false
    },
    "narrative_purpose": {
      "type": "string",
      "minLength": 1
    },
    "shot_type": {
      "type": "string",
      "enum": [
        "dialogue",
        "action",
        "camera_motion",
        "vfx",
        "establishing",
        "transition"
      ]
    },
    "asset_bindings": {
      "type": "object",
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "character": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "id",
                  "revision"
                ],
                "additionalProperties": false
              },
              "costume": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "id",
                  "revision"
                ],
                "additionalProperties": false
              },
              "voice": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "id",
                  "revision"
                ],
                "additionalProperties": false
              },
              "screen_role": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "character",
              "costume",
              "voice",
              "screen_role"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "scene": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "id",
            "revision"
          ],
          "additionalProperties": false
        },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "id",
              "revision"
            ],
            "additionalProperties": false
          }
        },
        "style": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "id",
            "revision"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "characters",
        "scene",
        "props",
        "style"
      ],
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "properties": {
        "shot_size": {
          "type": "string",
          "enum": [
            "extreme_wide",
            "wide",
            "full",
            "medium",
            "medium_close",
            "close",
            "extreme_close"
          ]
        },
        "angle": {
          "type": "string",
          "enum": [
            "eye_level",
            "low",
            "high",
            "overhead",
            "dutch"
          ]
        },
        "movement": {
          "type": "string",
          "enum": [
            "static",
            "push_in",
            "pull_out",
            "pan",
            "tilt",
            "tracking",
            "orbit",
            "handheld"
          ]
        },
        "movement_intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "composition": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "shot_size",
        "angle",
        "movement",
        "movement_intensity",
        "composition"
      ],
      "additionalProperties": false
    },
    "duration": {
      "type": "object",
      "properties": {
        "target_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "trim_allowed": {
          "type": "boolean"
        },
        "timing_policy": {
          "type": "string",
          "enum": [
            "ripple",
            "preserve_episode_duration"
          ]
        }
      },
      "required": [
        "target_seconds",
        "trim_allowed",
        "timing_policy"
      ],
      "additionalProperties": false
    },
    "output_spec": {
      "type": "object",
      "properties": {
        "aspect_ratio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "aspect_ratio",
        "width",
        "height",
        "fps"
      ],
      "additionalProperties": false
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time_range": {
            "type": "object",
            "properties": {
              "start_seconds": {
                "type": "number",
                "minimum": 0
              },
              "end_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "start_seconds",
              "end_seconds"
            ],
            "additionalProperties": false
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "time_range",
          "action"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "dialogue": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "character_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "type": "string",
            "minLength": 1
          },
          "emotion": {
            "type": "string",
            "minLength": 1
          },
          "voice": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "id",
              "revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "line_id",
          "character_id",
          "text",
          "locale",
          "emotion",
          "voice"
        ],
        "additionalProperties": false
      }
    },
    "emotion": {
      "type": "string",
      "minLength": 1
    },
    "lighting": {
      "type": "string",
      "minLength": 1
    },
    "continuity": {
      "type": "object",
      "properties": {
        "axis_of_action": {
          "type": "string",
          "minLength": 1
        },
        "screen_direction": {
          "type": "string",
          "minLength": 1
        },
        "state_in": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "state_out": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "previous_shot_ref": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "id",
                "revision"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "id",
              "revision"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "axis_of_action",
        "screen_direction",
        "state_in",
        "state_out",
        "previous_shot_ref",
        "reference_edges"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "must_preserve": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "locked_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "must_preserve",
        "negative",
        "locked_fields"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "shot_id",
    "revision",
    "episode_id",
    "scene_id",
    "display_locator",
    "narrative_purpose",
    "shot_type",
    "asset_bindings",
    "camera",
    "duration",
    "output_spec",
    "beats",
    "dialogue",
    "emotion",
    "lighting",
    "continuity",
    "constraints"
  ],
  "additionalProperties": false
}
