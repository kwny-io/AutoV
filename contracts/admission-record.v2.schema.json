{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drama.example.invalid/contracts/admission-record.v2.schema.json",
  "title": "admission-record v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "admission_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "$ref": "execution-context.v2.schema.json"
    },
    "route_decision_ref": {
      "type": "object",
      "properties": {
        "service_id": {
          "type": "string",
          "pattern": "^S[0-9]{2}$"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "service_id",
        "id",
        "revision",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "RESERVING",
        "ADMITTED",
        "DISPATCH_AUTHORIZED",
        "SUBMITTING",
        "SUBMISSION_UNKNOWN",
        "INFLIGHT",
        "SETTLED",
        "REJECTED"
      ]
    },
    "reservation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "const": "S23"
        },
        "amount_micro": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "RESERVED",
            "AUTHORIZED",
            "ACCRUED",
            "SETTLED",
            "RELEASED"
          ]
        }
      },
      "required": [
        "id",
        "authority",
        "amount_micro",
        "currency",
        "state"
      ],
      "additionalProperties": false
    },
    "quota_permit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "const": "S22"
        },
        "pool_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "RESERVED",
            "DISPATCH_AUTHORIZED",
            "INFLIGHT",
            "RELEASED"
          ]
        }
      },
      "required": [
        "id",
        "authority",
        "pool_id",
        "state"
      ],
      "additionalProperties": false
    },
    "dispatch": {
      "type": "object",
      "properties": {
        "dispatch_id": {
          "type": "string",
          "minLength": 1
        },
        "fencing_token": {
          "type": "integer",
          "minimum": 1
        },
        "grant_state": {
          "type": "string",
          "enum": [
            "NONE",
            "ISSUED",
            "CLAIMED",
            "REVOKED"
          ]
        },
        "provider_idempotency": {
          "type": "string",
          "enum": [
            "supported",
            "client_lookup_only",
            "unsupported"
          ]
        },
        "provider_job_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "dispatch_id",
        "fencing_token",
        "grant_state",
        "provider_idempotency",
        "provider_job_id"
      ],
      "additionalProperties": false
    },
    "must_reconcile_before_resubmit": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "admission_id",
    "attempt_id",
    "context",
    "route_decision_ref",
    "request_hash",
    "state",
    "reservation",
    "quota_permit",
    "dispatch",
    "must_reconcile_before_resubmit"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "SUBMISSION_UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "must_reconcile_before_resubmit": {
            "const": true
          },
          "reservation": {
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "AUTHORIZED",
                  "ACCRUED"
                ]
              }
            }
          },
          "quota_permit": {
            "properties": {
              "state": {
                "const": "INFLIGHT"
              }
            }
          },
          "dispatch": {
            "properties": {
              "grant_state": {
                "const": "CLAIMED"
              }
            }
          }
        }
      }
    }
  ]
}
