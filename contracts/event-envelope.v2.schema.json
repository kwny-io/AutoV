{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drama.example.invalid/contracts/event-envelope.v2.schema.json",
  "title": "event-envelope v2",
  "type": "object",
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "schema_version": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "home_cell": {
      "type": "string",
      "minLength": 1
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "aggregate_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": "string",
      "minLength": 1
    },
    "traceparent": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    },
    "data_ref": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "service_id": {
              "type": "string",
              "pattern": "^S[0-9]{2}$"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "service_id",
            "id",
            "revision",
            "content_hash"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "specversion",
    "schema_version",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "tenant_id",
    "home_cell",
    "aggregate_id",
    "aggregate_sequence",
    "correlation_id",
    "causation_id",
    "traceparent",
    "data",
    "data_ref"
  ],
  "additionalProperties": false
}
