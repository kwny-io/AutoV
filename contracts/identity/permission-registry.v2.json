{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vflow.local/contracts/identity/permission-registry.v2.json",
  "title": "permission_key 注册表 v2",
  "description": "plans/S01-tenant-access.md §11 C11 缺失的权限键注册表。S01 的 role 通配校验、S02 的门判定、S46 的 MCP scope 映射都依赖它。每条都标注了在 plans/ 里的出处；没有出处的键不进本表。",
  "x-source": "从 plans/S01-tenant-access.md、S03–S06、S19、S20、S28、S40、S46 的命令表与权限段落提取",
  "type": "object",
  "required": [
    "schema_version",
    "naming_rule",
    "permissions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "naming_rule": {
      "const": "<domain>.<resource>[.<action>]",
      "description": "两段或三段：资源型权限（如 project.get、review.decide）在两段式里省略 action。S01 plan 原文即如此，不能为凑格式改名。"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "domain",
          "risk",
          "needs_budget_scope",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,}$"
          },
          "domain": {
            "type": "string",
            "enum": [
              "platform",
              "tenant",
              "org",
              "creative",
              "production",
              "review",
              "budget",
              "integration",
              "asset",
              "agent"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "description": "high = 会触发付费或外部分发；破窗期间强制 deny（S01 §3.6）。"
          },
          "needs_budget_scope": {
            "type": "boolean",
            "description": "true 时 permission-checks 必须带 budget_scope_id，否则 422。"
          },
          "mcp_tool": {
            "type": [
              "string",
              "null"
            ],
            "description": "contracts/mcp-tools.v2.design.json 里的工具名；无映射为 null。"
          },
          "source": {
            "type": "string",
            "description": "在 plans/ 里的出处，格式 <file>:<line>。"
          }
        }
      }
    }
  },
  "permissions": [
